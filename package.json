{
  "name": "hshb",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow npm",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"e2e/**/*.ts\" \"playwright.config.ts\" --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "prepare": "husky || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "dotenv -e .env.e2e -- playwright test",
    "test:e2e:ui": "dotenv -e .env.e2e -- playwright test --ui",
    "gen:types": "cf-content-types-generator -s $CONTENTFUL_SPACE -t $CONTENTFUL_MANAGEMENT_TOKEN -o src/types/contentful",
    "pipeline:check": "npm run lint && npm run format:check && npm run type-check && npm run test:coverage && npm run test:e2e && npm run build",
    "fix:all": "npm run lint:fix && npm run format && npm run type-check"
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@next/third-parties": "16.3.5",
    "babel-plugin-react-compiler": "1.0.0",
    "clsx": "2.1.1",
    "contentful": "11.12.10",
    "next": "16.3.5",
    "next-mdx-remote": "6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "9.39.4",
    "@netlify/plugin-nextjs": "5.15.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.8",
    "autoprefixer": "10.6.0",
    "cf-content-types-generator": "3.0.1",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.1",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.8"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.1",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "npm": ">=11.9.0",
    "node": ">=24.14.0"
  }
}
